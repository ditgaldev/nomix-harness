# Copy to production.env and configure the production service before selecting this preset.
NOMIX_DESKTOP_APP_ID=com.nomix.harness
NOMIX_DESKTOP_AUTO_UPDATE_ENV=production
NOMIX_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
NOMIX_DESKTOP_MACOS_PACK_CONCURRENCY=4
NOMIX_DESKTOP_MACOS_DOWNLOAD_PROXY=
NOMIX_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# NOMIX_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
