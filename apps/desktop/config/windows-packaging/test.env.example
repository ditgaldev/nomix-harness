# Copy to test.env in the same machine configuration directory and fill in the values.
# Public test configuration. No PIN or upload credentials belong here.
NOMIX_DESKTOP_APP_ID=com.nomix.harness
NOMIX_DESKTOP_AUTO_UPDATE_ENV=test
NOMIX_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
# Replace login.example.com with the real login origin before packaging.
NOMIX_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
# Required for signed test packages; retain the release ID for an upgrade test batch.
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=
# Optional absolute private cache directory. Omit to retain the account default cache.
# NOMIX_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
NOMIX_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
