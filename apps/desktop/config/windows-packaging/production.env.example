# Copy to production.env in the same machine configuration directory and fill in the values.
NOMIX_DESKTOP_APP_ID=com.nomix.harness
NOMIX_DESKTOP_AUTO_UPDATE_ENV=production
NOMIX_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
NOMIX_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# NOMIX_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
NOMIX_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
