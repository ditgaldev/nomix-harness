{
  "name": "@nomix-ai/nomix-web-frontend",
  "description": "Web application entry: vite build over the @nomix-ai/nomix-client-web shell library; dist/ served by apps/cli's nomix web",
  "version": "0.2.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @nomix-ai/nomix-experimental-webworker-runtime exec tsdown && pnpm --filter @nomix-ai/nomix-experimental-webworker-packer exec tsdown && vite build && nomix-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomix-ai/cordis-plugin-group": "workspace:~",
    "@nomix-ai/nomix-client-modules": "workspace:*",
    "@nomix-ai/nomix-client-store": "workspace:*",
    "@nomix-ai/nomix-llm-mock-server": "workspace:*",
    "@nomix-ai/nomix-client-test-runtime": "workspace:*",
    "@nomix-ai/nomix-client-ui-deliverables": "workspace:*",
    "@nomix-ai/nomix-client-ui-dockkit": "workspace:*",
    "@nomix-ai/nomix-client-ui-primitives": "workspace:*",
    "@nomix-ai/nomix-client-ui-slots": "workspace:*",
    "@nomix-ai/nomix-client-web": "workspace:*",
    "@nomix-ai/nomix-cmdline": "workspace:*",
    "@nomix-ai/nomix-pwsh-local": "workspace:*",
    "@nomix-ai/nomix-experimental-agent-team": "workspace:*",
    "@nomix-ai/nomix-experimental-webworker-packer": "workspace:*",
    "@nomix-ai/nomix-experimental-webworker-runtime": "workspace:*",
    "@nomix-ai/nomix-remote-mock": "workspace:*",
    "@nomix-ai/nomix-session-projection-cache": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@nomix-ai/nomix-client-ui-theme": "workspace:*",
    "@nomix-ai/nomix-launch-environment": "workspace:*",
    "@nomix-ai/nomix-workspace-changes": "workspace:*",
    "@nomix-ai/nomix-subprocess-local": "workspace:*",
    "@nomix-ai/nomix-experimental-auto-review": "workspace:*",
    "@nomix-ai/nomix-experimental-speech-to-text": "workspace:*",
    "@nomix-ai/nomix-experimental-voice-input-bundle": "workspace:*",
    "@nomix-ai/nomix-experimental-cot-translation-bundle": "workspace:*",
    "@nomix-ai/nomix-experimental-worktree": "workspace:*",
    "@nomix-ai/nomix-experimental-plugin-market-bundle": "workspace:*"
  }
}
