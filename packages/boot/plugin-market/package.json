{
  "name": "@nomix-ai/nomix-plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/nomix-app-boot": "workspace:*",
    "@nomix-ai/nomix-package-manifest": "workspace:*",
    "@nomix-ai/nomix-plugin-market-index": "workspace:*",
    "@nomix-ai/nomix-timeout": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-plugin-manager": "workspace:*",
    "@nomix-ai/nomix-settings": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/cosmokit": "workspace:~",
    "@nomix-ai/nomix-app-boot": "workspace:*",
    "@nomix-ai/nomix-config-editor": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-plugin-manager": "workspace:*",
    "@nomix-ai/nomix-settings": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@types/semver": "^7.8.0"
  }
}
