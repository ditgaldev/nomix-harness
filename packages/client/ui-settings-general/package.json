{
  "name": "@nomix-ai/nomix-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nomix": {
    "client": {
      "inject": [
        "@nomix-ai/nomix-client-ui-settings",
        "@nomix-ai/nomix-client-locale",
        "@nomix-ai/nomix-client-connection",
        "@nomix-ai/nomix-api-remotes",
        "@nomix-ai/nomix-client-ui-sidebar",
        "@nomix-ai/nomix-client-shortcuts",
        "@nomix-ai/nomix-client-modules",
        "@nomix-ai/nomix-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-api-remotes": "workspace:*",
    "@nomix-ai/nomix-client-connection": "workspace:*",
    "@nomix-ai/nomix-client-locale": "workspace:*",
    "@nomix-ai/nomix-client-modules": "workspace:*",
    "@nomix-ai/nomix-client-store": "workspace:*",
    "@nomix-ai/nomix-client-test-runtime": "workspace:*",
    "@nomix-ai/nomix-client-ui-layout": "workspace:*",
    "@nomix-ai/nomix-client-ui-primitives": "workspace:*",
    "@nomix-ai/nomix-client-ui-renderer": "workspace:*",
    "@nomix-ai/nomix-client-ui-session": "workspace:*",
    "@nomix-ai/nomix-client-ui-settings": "workspace:*",
    "@nomix-ai/nomix-client-ui-sidebar": "workspace:*",
    "@nomix-ai/nomix-client-ui-slots": "workspace:*",
    "@nomix-ai/nomix-remote-mock": "workspace:*",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@nomix-ai/nomix-settings": "workspace:*",
    "react-dom": "^18.2.0",
    "@nomix-ai/nomix-client-shortcuts": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
