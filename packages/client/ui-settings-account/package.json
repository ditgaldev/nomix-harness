{
  "name": "@nomix-ai/nomix-client-ui-settings-account",
  "description": "Manage DeepSeek login and open Platform billing pages",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/client/ui-settings-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nomix": {
    "client": {
      "inject": [
        "@nomix-ai/nomix-api-remotes",
        "@nomix-ai/nomix-client-locale",
        "@nomix-ai/nomix-client-ui-chat",
        "@nomix-ai/nomix-client-ui-layout",
        "@nomix-ai/nomix-client-ui-settings",
        "@nomix-ai/nomix-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-api-remotes": "workspace:*",
    "@nomix-ai/nomix-client-locale": "workspace:*",
    "@nomix-ai/nomix-client-store": "workspace:*",
    "@nomix-ai/nomix-client-test-runtime": "workspace:*",
    "@nomix-ai/nomix-client-ui-chat": "workspace:*",
    "@nomix-ai/nomix-client-ui-layout": "workspace:*",
    "@nomix-ai/nomix-client-ui-primitives": "workspace:*",
    "@nomix-ai/nomix-client-ui-renderer": "workspace:*",
    "@nomix-ai/nomix-client-ui-settings": "workspace:*",
    "@nomix-ai/nomix-client-ui-slots": "workspace:*",
    "@nomix-ai/nomix-client-ui-theme": "workspace:*",
    "@nomix-ai/nomix-deepseek-account": "workspace:*",
    "@nomix-ai/nomix-settings": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/big.js": "^6.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@nomix-ai/nomix-client-ui-settings-models": "workspace:*",
    "@nomix-ai/nomix-host-webserver": "workspace:*",
    "big.js": "^7.0.1",
    "@nomix-ai/nomix-client-product-analytics": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~"
  }
}
