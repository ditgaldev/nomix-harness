{
  "name": "@nomix-ai/nomix-skill",
  "description": "Agent skill provider registry for the Nomix Harness",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/skill/skill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*"
  }
}
