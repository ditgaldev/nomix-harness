{
  "name": "@nomix-ai/nomix-acp",
  "description": "Automation-only Agent Client Protocol server for driving Nomix Harness agents over JSON-RPC stdio",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-mcp-client": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-token-meter": "workspace:*",
    "@nomix-ai/nomix-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-loop": "workspace:*",
    "@nomix-ai/nomix-agent-loop-testkit": "workspace:*",
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-mcp-client": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-session-persistence-jsonl": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-subagent": "workspace:*",
    "@nomix-ai/nomix-token-meter": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/nomix-user-approval": "workspace:*"
  }
