{
  "name": "@nomix-ai/nomix-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Nomix Harness",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/nomix-workspace": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/nomix-typert-registry": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/nomix-workspace": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  }
}
