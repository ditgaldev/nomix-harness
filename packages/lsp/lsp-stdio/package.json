{
  "name": "@nomix-ai/nomix-lsp-stdio",
  "description": "Generic stdio language-server provider for the Nomix Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-brand": "workspace:^",
    "@nomix-ai/nomix-fs": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-lsp": "workspace:^",
    "@nomix-ai/nomix-subprocess": "workspace:^",
    "@nomix-ai/nomix-timeout": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/nomix-brand": "workspace:^",
    "@nomix-ai/nomix-fs": "workspace:^",
    "@nomix-ai/nomix-fs-local": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-lsp": "workspace:^",
    "@nomix-ai/nomix-subprocess": "workspace:^",
    "@nomix-ai/nomix-subprocess-local": "workspace:^",
    "@nomix-ai/nomix-timeout": "workspace:^",
    "@nomix-ai/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
