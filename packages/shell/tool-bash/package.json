{
  "name": "@nomix-ai/nomix-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.2.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-shell": "workspace:^",
    "@nomix-ai/nomix-shell-env": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-sandbox": "workspace:^",
    "@nomix-ai/nomix-sandbox-policy": "workspace:^",
    "@nomix-ai/nomix-system-prompt": "workspace:^",
    "@nomix-ai/nomix-jobs": "workspace:^",
    "@nomix-ai/nomix-tools": "workspace:^",
    "@nomix-ai/nomix-user-approval": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-agent-loop": "workspace:^",
    "@nomix-ai/nomix-agent-loop-testkit": "workspace:^",
    "@nomix-ai/nomix-shell": "workspace:^",
    "@nomix-ai/nomix-shell-env": "workspace:^",
    "@nomix-ai/nomix-bash-local": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-subprocess-local": "workspace:^",
    "@nomix-ai/nomix-sandbox": "workspace:^",
    "@nomix-ai/nomix-sandbox-policy": "workspace:^",
    "@nomix-ai/nomix-session": "workspace:^",
    "@nomix-ai/nomix-session-persistence-jsonl": "workspace:^",
    "@nomix-ai/nomix-system-prompt": "workspace:^",
    "@nomix-ai/nomix-jobs": "workspace:^",
    "@nomix-ai/nomix-jobs-local": "workspace:^",
    "@nomix-ai/nomix-tool-jobs": "workspace:^",
    "@nomix-ai/nomix-tools": "workspace:^",
    "@nomix-ai/nomix-user-approval": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  }
}
