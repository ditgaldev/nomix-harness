{
  "name": "@nomix-ai/nomix-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "0.2.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/typert/loader"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-typert-registry": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/nomix-app-boot": "workspace:*",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-typert-registry": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
