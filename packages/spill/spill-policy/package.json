    "@nomix-ai/nomix-spill": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-token-meter": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
