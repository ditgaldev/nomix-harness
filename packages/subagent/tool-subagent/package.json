{
  "name": "@nomix-ai/nomix-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.2.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./model-selection-settings/locale/*.json": "./locale/model-selection-settings/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/model-selection-settings/*.json",
    "lib/index.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-preset-registry": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-subagent": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-agent-preset-registry": {
      "optional": true
    }
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-preset-registry": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-session-persistence-jsonl": "workspace:*",
    "@nomix-ai/nomix-subagent": "workspace:*",
    "@nomix-ai/nomix-subagent-spawn-in-process": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-session-projection": "workspace:*"
  }
}
