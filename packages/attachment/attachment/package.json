{
  "name": "@nomix-ai/nomix-attachment",
  "description": "Durable immutable attachment storage seam for the Nomix Harness",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/attachment/attachment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-brand": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/nomix-brand": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  }
}
