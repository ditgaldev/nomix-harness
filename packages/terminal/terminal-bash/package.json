{
  "name": "@nomix-ai/nomix-terminal-bash",
  "description": "Persistent shell PTY backend over the Nomix Harness subprocess terminal primitive",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-terminal": "workspace:*",
    "@nomix-ai/nomix-sandbox": "workspace:*",
    "@nomix-ai/nomix-sandbox-policy": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-working-directory": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/nomix-lazy-require": "workspace:*",
    "@nomix-ai/nomix-pwsh-local": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-loop-testkit": "workspace:*",
    "@nomix-ai/nomix-terminal": "workspace:*",
    "@nomix-ai/nomix-sandbox": "workspace:*",
    "@nomix-ai/nomix-sandbox-policy": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-subprocess-local": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-working-directory": "workspace:*"
  }
}
