{
  "name": "@nomix-ai/nomix-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-terminal": "workspace:^",
    "@nomix-ai/nomix-output-retention": "workspace:^",
    "@nomix-ai/nomix-system-prompt": "workspace:^",
    "@nomix-ai/nomix-jobs": "workspace:^",
    "@nomix-ai/nomix-tools": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/cordis-plugin-include": "workspace:^",
    "@nomix-ai/cordis-plugin-loader": "workspace:^",
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-terminal": "workspace:^",
    "@nomix-ai/nomix-terminal-bash": "workspace:^",
    "@nomix-ai/nomix-output-retention": "workspace:^",
    "@nomix-ai/nomix-sandbox": "workspace:^",
    "@nomix-ai/nomix-sandbox-policy": "workspace:^",
    "@nomix-ai/nomix-session": "workspace:^",
    "@nomix-ai/nomix-subprocess-local": "workspace:^",
    "@nomix-ai/nomix-system-prompt": "workspace:^",
    "@nomix-ai/nomix-jobs": "workspace:^",
    "@nomix-ai/nomix-jobs-local": "workspace:^",
    "@nomix-ai/nomix-tool-jobs": "workspace:^",
    "@nomix-ai/nomix-tools": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  }
}
