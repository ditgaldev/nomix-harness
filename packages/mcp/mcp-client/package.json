{
  "name": "@nomix-ai/nomix-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-timeout": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-mcp-resources": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@nomix-ai/nomix-util-values": "workspace:*"
  },
  "devDependencies": {
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-attachment-local": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-timeout": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.4.3",
    "@nomix-ai/nomix-mcp-resources": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-mcp-resources": {
      "optional": true
    },
    "@nomix-ai/nomix-system-prompt": {
      "optional": true
    }
  }
}
