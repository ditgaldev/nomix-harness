    "@nomix-ai/nomix-compaction": "workspace:*",
    "@nomix-ai/nomix-compaction-tool-result-pruner": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-token-meter": "workspace:*"
  },
  "peerDependenciesMeta": {
