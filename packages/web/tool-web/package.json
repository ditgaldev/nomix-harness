{
  "name": "@nomix-ai/nomix-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Nomix Harness web capability seam (ctx.web)",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/nomix-web": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-spill-local": "workspace:*",
    "@nomix-ai/nomix-spill-policy": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-tool-call-timeout-policy": "workspace:*",
    "@nomix-ai/nomix-tools": "workspace:*",
    "@nomix-ai/nomix-web": "workspace:*",
    "@nomix-ai/nomix-web-fetch-http": "workspace:*",
    "@nomix-ai/nomix-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-token-meter": "workspace:*"
  }
}
