{
  "name": "@nomix-ai/nomix-web-deepseek-api",
  "description": "DeepSeek Search and Fetch API providers for the Nomix Harness web capability seam (ctx.web)",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/web/web-deepseek-api"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-credentials": "workspace:*",
    "@nomix-ai/nomix-deepseek-account": "workspace:*",
    "@nomix-ai/nomix-launch-environment": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-web": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-credentials": "workspace:*",
    "@nomix-ai/nomix-credentials-local": "workspace:*",
    "@nomix-ai/nomix-deepseek-account": "workspace:*",
    "@nomix-ai/nomix-launch-environment": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-web": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-deepseek-account": {
      "optional": true
    }
  }
}
