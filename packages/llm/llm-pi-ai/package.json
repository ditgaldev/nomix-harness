{
  "name": "@nomix-ai/nomix-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Nomix Harness LLM seam (design-verification twin of nomix-llm-deepseek)",
  "version": "0.2.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-authorization": "workspace:*",
    "@nomix-ai/nomix-credentials": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-launch-environment": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-timeout": "workspace:*",
    "@nomix-ai/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-attachment": "workspace:*",
    "@nomix-ai/nomix-authorization": "workspace:*",
    "@nomix-ai/nomix-credentials": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-launch-environment": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-llm-deepseek": "workspace:*",
    "@nomix-ai/nomix-llm-deepseek-api-key": "workspace:*",
    "@nomix-ai/nomix-timeout": "workspace:*",
    "@nomix-ai/nomix-http-proxy": "workspace:*",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/cordis-plugin-loader": {
      "optional": true
    }
  }
}
