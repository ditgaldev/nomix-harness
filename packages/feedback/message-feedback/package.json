{
  "name": "@nomix-ai/nomix-message-feedback",
  "description": "Canonical Session-log ratings and notes for finalized assistant messages",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/feedback/message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-command-feedback": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nomix-ai/cordis-plugin-include": "workspace:~",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-session-persistence-jsonl": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-command-feedback": "workspace:*"
  }
}
