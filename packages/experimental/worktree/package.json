{
  "name": "@nomix-ai/nomix-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.12",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:~",
    "@nomix-ai/nomix-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-sandbox": "workspace:*",
    "@nomix-ai/nomix-sandbox-policy": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-loop-testkit": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-fs-local": "workspace:*",
    "@nomix-ai/nomix-sandbox": "workspace:*",
    "@nomix-ai/nomix-sandbox-local": "workspace:*",
    "@nomix-ai/nomix-sandbox-policy": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-subprocess-local": "workspace:*",
    "@nomix-ai/nomix-system-prompt": "workspace:*",
    "@nomix-ai/nomix-working-directory": "workspace:*"
  }
}
