{
  "name": "@nomix-ai/nomix-experimental-client-ui-claude-code-mods",
  "description": "Web band above the prompt for Claude Code mods: draws each session's mod tree and sends button presses back to the bridge",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/experimental/client-ui-claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nomix": {
    "client": {
      "inject": [
        "@nomix-ai/nomix-api-remotes",
        "@nomix-ai/nomix-api-session-controller",
        "@nomix-ai/nomix-client-locale",
        "@nomix-ai/nomix-client-ui-conversation",
        "@nomix-ai/nomix-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-api-remotes": "workspace:*",
    "@nomix-ai/nomix-api-session-controller": "workspace:*",
    "@nomix-ai/nomix-client-locale": "workspace:*",
    "@nomix-ai/nomix-client-test-runtime": "workspace:*",
    "@nomix-ai/nomix-client-ui-conversation": "workspace:*",
    "@nomix-ai/nomix-client-ui-primitives": "workspace:*",
    "@nomix-ai/nomix-client-ui-renderer": "workspace:*",
    "@nomix-ai/nomix-client-ui-session": "workspace:*",
    "@nomix-ai/nomix-client-ui-slots": "workspace:*",
    "@nomix-ai/nomix-experimental-claude-code-mods": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
