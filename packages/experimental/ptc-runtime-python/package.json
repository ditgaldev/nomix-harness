{
  "name": "@nomix-ai/nomix-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Nomix Harness PTC execution seam",
  "version": "0.2.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
