{
  "name": "@nomix-ai/nomix-experimental-session-titles-bundle",
  "description": "Refresh session titles as new human prompts arrive.",
  "version": "0.2.9",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/experimental/session-titles-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nomix": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@nomix-ai/nomix-session-title-all-prompts-llm": "workspace:*"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~"
  }
}
