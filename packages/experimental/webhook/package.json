{
  "name": "@nomix-ai/nomix-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Nomix Harness Sessions",
  "version": "0.2.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-default-model": "workspace:*",
    "@nomix-ai/nomix-agent-preset-registry": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-permission-presets": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-title": "workspace:*",
    "@nomix-ai/nomix-workspace": "workspace:*"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/cordis-plugin-include": "workspace:~",
    "@nomix-ai/cordis-plugin-loader": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-agent-default-model": "workspace:*",
    "@nomix-ai/nomix-agent-preset-registry": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-permission-presets": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-title": "workspace:*",
    "@nomix-ai/nomix-workspace": "workspace:*"
  },
  "dependencies": {
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*"
  }
}
