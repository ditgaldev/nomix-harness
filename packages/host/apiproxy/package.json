{
  "name": "@nomix-ai/nomix-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/nomix-attachment": "workspace:^",
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-agent-default-model": "workspace:^",
    "@nomix-ai/nomix-api-remotes": "workspace:^",
    "@nomix-ai/nomix-brand": "workspace:^",
    "@nomix-ai/nomix-commands": "workspace:^",
    "@nomix-ai/nomix-credentials": "workspace:^",
    "@nomix-ai/nomix-goal": "workspace:^",
    "@nomix-ai/nomix-host-directory-picker": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-native-command": "workspace:^",
    "@nomix-ai/nomix-session": "workspace:^",
    "@nomix-ai/nomix-session-persistence": "workspace:^",
    "@nomix-ai/nomix-session-projection": "workspace:^",
    "@nomix-ai/nomix-session-projection-cache": "workspace:^",
    "@nomix-ai/nomix-session-query": "workspace:^",
    "@nomix-ai/nomix-session-title": "workspace:^",
    "@nomix-ai/nomix-settings": "workspace:^",
    "@nomix-ai/nomix-skill": "workspace:^",
    "@nomix-ai/nomix-subagent": "workspace:^",
    "@nomix-ai/nomix-jobs": "workspace:^",
    "@nomix-ai/nomix-tools": "workspace:^",
    "@nomix-ai/nomix-user-approval": "workspace:^",
    "@nomix-ai/nomix-user-questions": "workspace:^",
    "@nomix-ai/nomix-workspace": "workspace:^",
    "@nomix-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "workspace:^",
    "@nomix-ai/nomix-agent-presets": "workspace:^",
    "@nomix-ai/nomix-cordis-host-runner": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:^",
    "@nomix-ai/nomix-agent-presets": "workspace:^",
    "@nomix-ai/nomix-cordis-host-runner": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-storage": "workspace:^",
    "@nomix-ai/nomix-storage-domain": "workspace:^",
    "@nomix-ai/nomix-typert-protocol": "workspace:^",
    "@nomix-ai/nomix-typert-registry": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  }
}
