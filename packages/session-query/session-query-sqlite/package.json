{
  "name": "@nomix-ai/nomix-session-query-sqlite",
  "description": "Concrete ctx.sessionQuery backend with SQLite FTS5 search",
  "version": "0.2.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/session-query/session-query-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
