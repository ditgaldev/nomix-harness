{
  "name": "@nomix-ai/nomix-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Nomix Harness SDK clients",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-llm-deepseek": "workspace:^",
    "@nomix-ai/nomix-scope": "workspace:^",
    "@nomix-ai/nomix-sdk-protocol": "workspace:^",
    "@nomix-ai/nomix-session": "workspace:^",
    "@nomix-ai/nomix-subagent": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nomix-ai/cordis-plugin-loader": "workspace:^",
    "@nomix-ai/nomix-agent": "workspace:^",
    "@nomix-ai/nomix-agent-spine-demo": "workspace:^",
    "@nomix-ai/nomix-invariants": "workspace:^",
    "@nomix-ai/nomix-llm": "workspace:^",
    "@nomix-ai/nomix-llm-deepseek": "workspace:^",
    "@nomix-ai/nomix-scope": "workspace:^",
    "@nomix-ai/nomix-sdk-protocol": "workspace:^",
    "@nomix-ai/nomix-session": "workspace:^",
    "@nomix-ai/nomix-session-persistence-jsonl": "workspace:^",
    "@nomix-ai/nomix-subagent": "workspace:^",
    "@nomix-ai/cordis": "workspace:^"
  }
}
