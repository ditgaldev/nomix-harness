{
  "name": "@nomix-ai/nomix-api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.2.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-harness.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nomix": {
    "client": {
      "inject": [
        "@nomix-ai/nomix-api-gateway"
      ],
      "external": [
        "@nomix-ai/nomix-api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@nomix-ai/nomix-deque": "workspace:*",
    "@nomix-ai/nomix-lazy-require": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
    "@nomix-ai/schemastery": "workspace:~",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "workspace:~",
    "@nomix-ai/nomix-agent": "workspace:*",
    "@nomix-ai/nomix-api-gateway": "workspace:*",
    "@nomix-ai/nomix-brand": "workspace:*",
    "@nomix-ai/nomix-client-connection": "workspace:*",
    "@nomix-ai/nomix-client-store": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-remote-mock": "workspace:*",
    "@nomix-ai/nomix-sandbox": "workspace:*",
    "@nomix-ai/nomix-sandbox-policy": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-subprocess": "workspace:*",
    "@nomix-ai/nomix-subprocess-local": "workspace:*",
    "@nomix-ai/nomix-util-crypto": "workspace:*",
    "@nomix-ai/nomix-working-directory": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
