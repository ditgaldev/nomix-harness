    "@nomix-ai/nomix-credentials": "workspace:*",
    "@nomix-ai/nomix-file-reference": "workspace:*",
    "@nomix-ai/nomix-fs": "workspace:*",
    "@nomix-ai/nomix-llm": "workspace:*",
    "@nomix-ai/nomix-native-command": "workspace:*",
    "@nomix-ai/nomix-scope": "workspace:*",
    "@nomix-ai/nomix-session": "workspace:*",
    "@nomix-ai/nomix-session-persistence": "workspace:*",
    "@nomix-ai/nomix-session-projection": "workspace:*",
    "@nomix-ai/nomix-session-projection-cache": "workspace:*",
    "@nomix-ai/nomix-session-query": "workspace:*",
    "@nomix-ai/nomix-session-title": "workspace:*",
    "@nomix-ai/nomix-settings": "workspace:*",
    "@nomix-ai/nomix-skill": "workspace:*",
    "@nomix-ai/nomix-subagent": "workspace:*",
    "@nomix-ai/nomix-typert-protocol": "workspace:*",
    "@nomix-ai/nomix-typert-registry": "workspace:*",
    "@nomix-ai/nomix-util-time": "workspace:*",
    "@nomix-ai/nomix-util-values": "workspace:*",
